{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5008" }
    }
  },
  "Agent": {
    "Id": "hybrid-support-team",
    "Provider": "deepseek",
    "Model": "deepseek-v4-flash"
  },
  "LLMProvider": {
    "DeepSeek": { "ApiKey": "" }
  },
  "HybridRouting": {
    "RoutingMode": "Hybrid",
    "SemanticWeight": 0.65,
    "KeywordWeight": 0.25,
    "PriorityWeight": 0.10,
    "TopCandidates": 5,
    "MinMatchScore": 0.35,
    "AmbiguityGap": 0.08,
    "EnableDeterministicRerank": true,
    "ReturnRoutingDiagnostics": true,
    "OllamaEndpoint": "http://localhost:11434",
    "EmbedModel": "mxbai-embed-large"
  }
}
