{
  "$schema": "http://json.schemastore.org/template",
  "author": "AGXIOME",
  "classifications": ["AI", "Team", "ForestSwarm", "AGXIOME"],
  "identity": "AGXIOME.TeamTemplate.CSharp",
  "name": "AGXIOME Team (ForestSwarm)",
  "shortName": "agxioma-team",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "AgxiomaTeam",
  "preferNameDirectory": true,
  "symbols": {
    "provider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "deepseek",
      "choices": [
        { "choice": "deepseek",  "description": "DeepSeek API" },
        { "choice": "openai",    "description": "OpenAI API" },
        { "choice": "anthropic", "description": "Anthropic API" },
        { "choice": "gemini",    "description": "Google Gemini API" },
        { "choice": "ollama",    "description": "Ollama (local)" }
      ],
      "replaces": "PROVIDER_PLACEHOLDER"
    },
    "model": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "MODEL_PLACEHOLDER"
    },
    "port": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "5011",
      "replaces": "PORT_PLACEHOLDER"
    }
  }
}
