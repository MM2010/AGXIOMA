{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "<url to listen on>" }
    }
  },
  "Wiki": {
    "ProjectRootPath": "<path to codebase root>",
    "WikiOutputPath": "<path to wiki output>",
    "LLMModel": "deepseek-v4-flash",
    "LLMProvider": "deepseek",
    "OllamaBaseUrl": "<ollama base url>",
    "EmbedModel": "<embed model>",
    "EmbedDimensions": "<embed dimensions>",
    "ChunkMaxTokens": "<chunk max tokens>",
    "ChunkOverlap": "<chunk overlap>",
    "EmbedMaxChars": "<embed max chars>",
    "TopK": "<top k>",
    "TopN": "<top n>",
    "Temperature": "<temperature>", 
    "MinScore": "<min score>",
    "SourceExtensions": [ "<file types>" ],
    "SourceExcludes": [ "<exclude patterns>" ],
    "IngestParallelism": 16
  },
  "ConnectionStrings": {
    "Postgres": "<db connection string>",
    "Redis": "<redis connection string>"
  }
}
