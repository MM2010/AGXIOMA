<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgxiomaLLMWiki</RootNamespace>
    <AssemblyName>AgxiomaLLMWiki</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- AGXIOMA framework references -->
    <ProjectReference Include="..\..\src\AGXIOME.Core\AGXIOME.Core.csproj" />
    <ProjectReference Include="..\..\src\AGXIOME.LLMWIKY\AGXIOME.LLMWIKY.csproj" />
    <ProjectReference Include="..\..\src\AGXIOME.Runtime\AGXIOME.Runtime.csproj" />
    <ProjectReference Include="..\..\src\AGXIOME.Shared\AGXIOME.Shared.csproj" />
    <ProjectReference Include="..\..\src\AGXIOME.Storage\AGXIOME.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- PostgreSQL + pgvector -->
    <PackageReference Include="Npgsql" Version="10.0.*" />
    <PackageReference Include="Dapper" Version="2.1.*" />
    <!-- Redis -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.*" />
  </ItemGroup>
</Project>
