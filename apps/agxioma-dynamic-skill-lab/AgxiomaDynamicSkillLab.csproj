<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgxiomaDynamicSkillLab</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- AGXIOME core + dynamic runtime -->
    <PackageReference Include="AGXIOME"                      Version="1.0.0-*" />
    <PackageReference Include="AGXIOME.DynamicRuntime"       Version="1.0.0-*" />
    <!-- Roslyn (referenced by DynamicRuntime, explicit here for clarity) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
    <!-- SQLite for audit + skill registry -->
    <PackageReference Include="Microsoft.Data.Sqlite"        Version="10.0.0-preview.*" />
  </ItemGroup>
</Project>
