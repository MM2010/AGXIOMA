{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5007" }
    }
  },
  "Agent": {
    "Provider": "DeepSeek",
    "Model": "deepseek-v4-flash",
    "DatabasePath":     "dynamic_skill_lab.db",
    "SandboxTempPath":  "sandbox_temp",
    "CompilationTimeoutMs": 15000,
    "ExecutionTimeoutMs":   10000
  }
}
