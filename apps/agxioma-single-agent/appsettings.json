{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "AGXIOME": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5000" }
    }
  },
  "Agent": {
    "Id": "single-agent",
    "SystemPrompt": "You are single-agent, a helpful AI assistant. Be concise and precise.",
    "MaxLoops": 10,
    "Model": "deepseek-v4-flash",
    "Provider": "DeepSeek"
  }
}
