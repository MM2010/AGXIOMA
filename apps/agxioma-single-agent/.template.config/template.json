{
  "$schema": "http://json.schemastore.org/template",
  "author": "AGXIOME",
  "classifications": ["AI", "Agent", "Web API"],
  "identity": "AGXIOME.SingleAgent",
  "name": "AGXIOME Single Agent",
  "shortName": "agxioma-agent",
  "description": "A production-ready single AI agent with REST + SSE streaming endpoints. Supports OpenAI, Anthropic, Ollama and any OpenAI-compatible provider.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "AgxiomaSingleAgent",
  "preferNameDirectory": true,
  "symbols": {
    "agentName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "MyAgent",
      "replaces": "MY_AGENT_NAME",
      "description": "The display name of your agent."
    },
    "provider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "openai",
      "description": "LLM provider to use.",
      "choices": [
        { "choice": "openai",    "description": "OpenAI (gpt-4o)" },
        { "choice": "anthropic", "description": "Anthropic (claude-3-7-sonnet)" },
        { "choice": "ollama",    "description": "Ollama local (llama3.2)" }
      ]
    },
    "openaiModel": {
      "type": "generated",
      "generator": "switch",
      "replaces": "PROVIDER_MODEL_PLACEHOLDER",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          { "condition": "(provider == \"openai\")",    "value": "gpt-4o" },
          { "condition": "(provider == \"anthropic\")", "value": "claude-3-7-sonnet-20250219" },
          { "condition": "(provider == \"ollama\")",    "value": "llama3.2" }
        ]
      }
    },
    "providerEnum": {
      "type": "generated",
      "generator": "switch",
      "replaces": "PROVIDER_ENUM_PLACEHOLDER",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          { "condition": "(provider == \"openai\")",    "value": "LLMProviderType.OpenAI" },
          { "condition": "(provider == \"anthropic\")", "value": "LLMProviderType.Anthropic" },
          { "condition": "(provider == \"ollama\")",    "value": "LLMProviderType.Ollama" }
        ]
      }
    },
    "port": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "5000",
      "replaces": "5000",
      "description": "HTTP port to listen on."
    }
  }
}
