{
  "$schema": "http://json.schemastore.org/template",
  "author": "AGXIOME",
  "classifications": ["AI", "Agent", "Swarm", "Code Review", "Web API"],
  "identity": "AGXIOME.CodeReviewer",
  "name": "AGXIOME Code Reviewer (GrokSwarm)",
  "shortName": "agxioma-code-reviewer",
  "description": "Multi-perspective code review using GrokSwarm: Captain orchestrates, Harper finds bugs & security issues, Benjamin analyses performance & logic, Lucas suggests architectural alternatives. Returns a structured review report.",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "AgxiomaCodeReviewer",
  "preferNameDirectory": true,
  "symbols": {
    "agentName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "CodeReviewer",
      "replaces": "MY_AGENT_NAME"
    },
    "provider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "openai",
      "choices": [
        { "choice": "openai",    "description": "OpenAI (gpt-4o)" },
        { "choice": "anthropic", "description": "Anthropic (claude-3-7-sonnet)" },
        { "choice": "ollama",    "description": "Ollama local (llama3.2)" }
      ]
    },
    "providerEnum": {
      "type": "generated",
      "generator": "switch",
      "replaces": "PROVIDER_ENUM_PLACEHOLDER",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          { "condition": "(provider == \"openai\")",    "value": "LLMProviderType.OpenAI" },
          { "condition": "(provider == \"anthropic\")", "value": "LLMProviderType.Anthropic" },
          { "condition": "(provider == \"ollama\")",    "value": "LLMProviderType.Ollama" }
        ]
      }
    },
    "modelName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "MODEL_PLACEHOLDER",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          { "condition": "(provider == \"openai\")",    "value": "gpt-4o" },
          { "condition": "(provider == \"anthropic\")", "value": "claude-3-7-sonnet-20250219" },
          { "condition": "(provider == \"ollama\")",    "value": "llama3.2" }
        ]
      }
    }
  }
}
