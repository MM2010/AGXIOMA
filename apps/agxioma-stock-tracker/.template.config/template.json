{
  "$schema": "http://json.schemastore.org/template",
  "author": "AGXIOME",
  "classifications": ["AI", "Agent", "Swarm", "Finance", "Stock", "Web API"],
  "identity": "AGXIOME.StockTracker",
  "name": "AGXIOME Stock Tracker (Heavy + Grok + Forest + SQLite)",
  "shortName": "agxioma-stock-tracker",
  "description": "Full-stack AI stock tracker combining three swarm patterns: ForestSwarm routes by asset type (stock/crypto/ETF), HeavySwarm performs deep multi-phase research, GrokSwarm debates Buy/Hold/Sell. Price history persisted in SQLite.",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "AgxiomaStockTracker",
  "preferNameDirectory": true,
  "symbols": {
    "provider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "openai",
      "choices": [
        { "choice": "openai",    "description": "OpenAI (gpt-4o)" },
        { "choice": "anthropic", "description": "Anthropic (claude-3-7-sonnet)" },
        { "choice": "ollama",    "description": "Ollama local (llama3.2)" }
      ]
    },
    "providerEnum": {
      "type": "generated",
      "generator": "switch",
      "replaces": "PROVIDER_ENUM_PLACEHOLDER",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          { "condition": "(provider == \"openai\")",    "value": "LLMProviderType.OpenAI" },
          { "condition": "(provider == \"anthropic\")", "value": "LLMProviderType.Anthropic" },
          { "condition": "(provider == \"ollama\")",    "value": "LLMProviderType.Ollama" }
        ]
      }
    },
    "modelName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "MODEL_PLACEHOLDER",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          { "condition": "(provider == \"openai\")",    "value": "gpt-4o" },
          { "condition": "(provider == \"anthropic\")", "value": "claude-3-7-sonnet-20250219" },
          { "condition": "(provider == \"ollama\")",    "value": "llama3.2" }
        ]
      }
    },
    "workerCount": {
      "type": "parameter",
      "datatype": "int",
      "defaultValue": "3",
      "replaces": "WORKER_COUNT_PLACEHOLDER"
    }
  }
}
