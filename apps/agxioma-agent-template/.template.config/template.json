{
  "$schema": "http://json.schemastore.org/template",
  "author": "AGXIOME",
  "classifications": ["AI", "Agent", "AGXIOME"],
  "identity": "AGXIOME.AgentTemplate.CSharp",
  "name": "AGXIOME Agent",
  "shortName": "agxioma-agent",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "AgxiomaAgent",
  "preferNameDirectory": true,
  "symbols": {
    "provider": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "deepseek",
      "choices": [
        { "choice": "deepseek", "description": "DeepSeek API" },
        { "choice": "openai", "description": "OpenAI API" },
        { "choice": "anthropic", "description": "Anthropic API" },
        { "choice": "gemini", "description": "Google Gemini API" }
      ],
      "replaces": "PROVIDER_PLACEHOLDER"
    },
    "model": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "deepseek-chat",
      "replaces": "MODEL_PLACEHOLDER"
    }
  }
}
