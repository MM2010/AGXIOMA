*.exp
*.ilk
*.nupkg
*.app
*.apk
*.msi
*.msp
*.appx
*.vsix

# ── .NET Native / AOT ───────────────────────
*.aotcache
*.llvmobj
*.r2r.*
*.ni.dll
*.ni.exe

# ── Environment & Secrets ───────────────────
.env
.env.*
!.env.example
!.env.template
*.env.local
*.env.development
*.env.production
*.env.staging
*.env.test
*.secret
secrets.json
appsettings.Local.json
appsettings.*.Local.json
credential*.json
*.cred

# ── Visual Studio ───────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
upack.logs/

# ── Visual Studio Code ──────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/*.code-snippets
!.vscode/*.md

# ── IDE / Editor Temp Files ─────────────────
*.swp
*.swo
*~
.~lock.*
*.bak
*.tmp
*.temp
*.log
*.cache

# ── JetBrains Rider ─────────────────────────
.idea/
*.sln.iml
*.sln.ide
*.userosscache

# ── Node / npm (if used in tooling) ─────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.eslintcache

# ── Python (if used in scripts) ─────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# ── OS Files ────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.lnk

# ── Testing & Coverage ──────────────────────
coverage/
*.coverage
*.coveragexml
*.trx
TestResults/
*.testlog
junit.xml

# ── Docker ──────────────────────────────────
docker-compose.override.yml
*.dockerignore

# ── NuGet ───────────────────────────────────
packages/
*.nuget.props
*.nuget.targets

# ── Miscellaneous ───────────────────────────
