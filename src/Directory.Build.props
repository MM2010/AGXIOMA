<Project>
  <!--
    AGXIOME Directory.Build.props — applies to all projects in src/
    - NU1603: benign version resolution warning (nuget resolves to available version)
    - NU1510: suppress package deprecation noise
    - NETSDK1057: using .NET preview SDK — intentional for net10.0 target
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1603;NU1510;NETSDK1057</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;**/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- ── NuGet common package metadata ── -->
  <PropertyGroup>
    <VersionPrefix>0.0.2</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <PackageVersion>0.0.2-beta</PackageVersion>
    <Authors>AGXIOME Team</Authors>
    <Company>AGXIOME</Company>
    <PackageProjectUrl>https://agxiome.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AGXIOME/AGXIOMA</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.NuGet.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>ai;agent;orchestration;llm;rag;vector-db;machine-learning;dotnet;csharp;signalr;cqrs</PackageTags>
    <Description>AGXIOME — .NET 10 agentic AI orchestration framework with CQRS, multi-model persistence, SignalR realtime, Zero Trust security, and full provider ecosystem (50+ LLM providers, 25 DB providers, 30 vector DBs).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'AGXIOME.CLI' and '$(MSBuildProjectName)' != 'AGXIOME.Runtime' and '$(MSBuildProjectName)' != 'AGXIOME.Tests'">
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true' or '$(MSBuildProjectName)' == 'AGXIOME.Shared' or '$(MSBuildProjectName)' == 'AGXIOME.Core'">
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.NuGet.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
