<Project>
  <!--
    AGXIOME Directory.Build.props — applies to all projects in src/
    - NU1603: benign version resolution warning (nuget resolves to available version)
    - NU1510: suppress package deprecation noise
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1603;NU1510</NoWarn>
  </PropertyGroup>
</Project>
