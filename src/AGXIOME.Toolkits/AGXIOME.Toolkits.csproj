<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AGXIOME.Toolkits</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AGXIOME.Shared\AGXIOME.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF text extraction -->
    <PackageReference Include="UglyToad.PdfPig" Version="0.1.9-alpha001-patch1" />
    <!-- Image processing (resize, convert, info) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <!-- DataAnalysis: CSV, Excel, SQLite -->
    <PackageReference Include="CsvHelper" Version="33.*" />
    <PackageReference Include="ClosedXML" Version="0.105.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
  </ItemGroup>

</Project>
