<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AGXIOME.Shared\AGXIOME.Shared.csproj" />
    <ProjectReference Include="..\AGXIOME.Core\AGXIOME.Core.csproj" />
    <!-- P19: SignalRCompletionNotifier bridges AGXIOME.Orchestration and SignalR -->
    <ProjectReference Include="..\AGXIOME.Orchestration\AGXIOME.Orchestration.csproj" />
  </ItemGroup>

  <!-- SignalR ships with ASP.NET Core in .NET 10 — use FrameworkReference instead of the
       old Microsoft.AspNetCore.SignalR 1.x package which pulled in Newtonsoft.Json 11.x (CVE) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
